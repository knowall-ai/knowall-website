# KnowAll AI Order Service configuration
# Copy to .env for local runs, or set these in the deployment environment.
# NEVER commit a real key — .env is gitignored.

# The KnowAll AI company identity's secret key (nsec1... or 64-char hex).
# Startup validates that this key derives to the company npub
# (npub1kue7etfxtkxlv0s4u2xjf9epgxj7hssmlhc4x2k66tn8q8598zfqj322ar)
# and refuses to run otherwise.
ORDER_SERVICE_KEY=nsec1...

# Lightning Address invoices are generated from (LNURL-pay).
LIGHTNING_ADDRESS=shop@example.com

# Relays (comma-separated). Defaults to the site's shop relay set when unset.
RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
